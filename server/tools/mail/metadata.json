{
  "name": "Mail",
  "version": "1.0",
  "description": "Mail senden, beantworten und lesen.",
  "tools": {
    "send_mail": {
      "name": "E-Mail senden",
      "input": "to, subject, body, optional attachments/cc/bcc",
      "output": "sent-Status, message_id",
      "capabilities": ["communication:email_send"],
      "side_effect_level": "high",
      "quality_signals": {
        "min_text_length": 40
      },
      "allows_goal_injection": false
    },
    "answer_mail": {
      "name": "E-Mail beantworten",
      "input": "mail_id, body",
      "output": "sent-Status",
      "capabilities": ["communication:email_send"],
      "side_effect_level": "high",
      "quality_signals": {
        "min_text_length": 20
      },
      "allows_goal_injection": false
    },
    "fetch_inbox_mails": {
      "name": "Inbox lesen",
      "input": "optional mailbox, limit",
      "output": "mail-Objekte",
      "capabilities": ["inbox_read"],
      "side_effect_level": "none"
    },
    "fetch_unanswered_mails": {
      "name": "Unbeantwortete Mails lesen",
      "input": "optional mailbox, limit",
      "output": "mail-Objekte",
      "capabilities": ["inbox_read"],
      "side_effect_level": "none"
    },
    "read_mail": {
      "name": "Einzelne Mail vollständig lesen",
      "input": "mail_id, optional mailbox/include_html/max_chars",
      "output": "Vollständige Maildaten inkl. body_text/body_html",
      "capabilities": ["inbox_read", "mail_content_read"],
      "side_effect_level": "none",
      "quality_signals": {
        "min_text_length": 40
      },
      "allows_goal_injection": false
    },
    "read_mail_thread": {
      "name": "Mail-Thread lesen",
      "input": "mail_id, optional mailbox/max_messages/include_html/max_chars",
      "output": "Thread-Nachrichten mit Text/Metadaten",
      "capabilities": ["inbox_read", "mail_content_read", "thread_read"],
      "side_effect_level": "none",
      "quality_signals": {
        "min_text_length": 40
      },
      "allows_goal_injection": false
    },
    "read_mail_attachments": {
      "name": "Mail-Anhänge lesen",
      "input": "mail_id, optional mailbox/include_content/max_attachment_chars/extract_text_pdf",
      "output": "Anhang-Liste inkl. Metadaten und optionalem Text",
      "capabilities": ["inbox_read", "mail_attachment_read"],
      "side_effect_level": "none",
      "quality_signals": {
        "min_text_length": 20
      },
      "allows_goal_injection": false
    },
    "classify_mail": {
      "name": "Mail-Absicht klassifizieren",
      "input": "text oder subject/body_text, optional from_email",
      "output": "intent (info|beschwerde|angebot|termin|eskalation|newsletter), confidence, reason",
      "capabilities": ["mail_intent_classification"],
      "side_effect_level": "none",
      "quality_signals": {
        "min_text_length": 10
      },
      "allows_goal_injection": false
    }
  }
}
