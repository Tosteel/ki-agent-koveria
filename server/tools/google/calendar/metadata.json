{
  "name": "Google Calendar",
  "version": "1.0",
  "description": "Google Calendar Integration für Verfügbarkeit, Terminanlage und Slot-Vorschläge.",
  "owner": "team",
  "provider": "google",
  "tools": {
    "calendar_check_availability": {
      "name": "Kalender-Verfügbarkeit prüfen",
      "input": "start_iso, end_iso, optional calendar_id/timezone",
      "output": "is_available, busy-Zeiträume",
      "capabilities": ["calendar_availability_read"],
      "side_effect_level": "none",
      "retry_policy": {
        "max_retries": 1,
        "backoff_ms": 300,
        "retry_on": ["timeout", "connection_error", "rate_limit"]
      },
      "quality_signals": {
        "min_text_length": 20
      },
      "allows_goal_injection": false
    },
    "calendar_create_event": {
      "name": "Kalender-Termin erstellen",
      "input": "summary, start_iso, end_iso, optional attendees/description/location",
      "output": "created, event_id, html_link",
      "capabilities": ["calendar_event_write"],
      "side_effect_level": "high",
      "retry_policy": {
        "max_retries": 0,
        "backoff_ms": 0,
        "retry_on": []
      },
      "quality_signals": {
        "min_text_length": 20
      },
      "allows_goal_injection": false
    },
    "calendar_propose_slots": {
      "name": "Freie Slots vorschlagen",
      "input": "start_iso, end_iso, duration_minutes, optional max_slots/step_minutes",
      "output": "freie Zeitfenster",
      "capabilities": ["calendar_availability_read", "calendar_slot_suggestion"],
      "side_effect_level": "none",
      "retry_policy": {
        "max_retries": 1,
        "backoff_ms": 300,
        "retry_on": ["timeout", "connection_error", "rate_limit"]
      },
      "quality_signals": {
        "min_text_length": 20
      },
      "allows_goal_injection": false
    }
  }
}
