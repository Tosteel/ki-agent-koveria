{
  "name": "Google Search",
  "version": "1.0",
  "description": "Google Custom Search fuer Web-Recherche.",
  "owner": "team",
  "provider": "google",
  "tools": {
    "google_search": {
      "name": "Google Suche",
      "input": "query, optional num/start/gl/hl/safe/site_search",
      "output": "count, total_results, items, text",
      "capabilities": [
        "web_search"
      ],
      "side_effect_level": "none",
      "retry_policy": {
        "max_retries": 1,
        "backoff_ms": 300,
        "retry_on": [
          "timeout",
          "connection_error",
          "rate_limit"
        ]
      },
      "quality_signals": {
        "min_hits": 1,
        "require_sources": true,
        "min_text_length": 40
      },
      "allows_goal_injection": true
    }
  }
}
