{
  "name": "Filesystem",
  "version": "1.0",
  "description": "Dateien lesen und schreiben.",
  "tools": {
    "file_read": {
      "name": "Datei lesen",
      "input": "path",
      "output": "text/content",
      "capabilities": ["artifact_read"],
      "side_effect_level": "none"
    },
    "file_write": {
      "name": "Datei schreiben",
      "input": "path, text/content",
      "output": "output_path",
      "capabilities": ["artifact_write"],
      "side_effect_level": "high",
      "allows_goal_injection": false
    }
  }
}
